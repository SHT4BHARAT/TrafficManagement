# [Dockerfile.api] Base Image for Backend Gateway
FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ui/ ./ui/
COPY core/ ./core/
COPY brain/ ./brain/
COPY edge/ ./edge/

EXPOSE 8000
CMD ["uvicorn", "ui.backend:app", "--host", "0.0.0.0", "--port", "8000"]
