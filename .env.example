# Redis (Hot Store)
REDIS_HOST=localhost
REDIS_PORT=6379

# TimescaleDB (Time-series)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres
TIMESCALE_DB=postgres

# Neo4j (Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=neo4j

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DAITFO_API_KEY=change-me-to-a-random-secret

# PostgreSQL (Docker Compose)
POSTGRES_PASSWORD=postgres

# Authentication
DAITFO_API_KEY=change-me-to-a-random-secret
ADMIN_API_KEY=change-me-to-a-different-random-secret

# Rate Limiting
SLOWAPI_RATE_LIMIT=60/minute

# Logging
LOG_LEVEL=INFO
