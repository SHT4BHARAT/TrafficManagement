# DAITFO TLS termination and routing
# In production, replace :443 with your actual domain
:443 {
    tls internal

    # Backend API
    handle_path /api/* {
        reverse_proxy backend-api:8000
    }

    handle_path /ws {
        reverse_proxy backend-api:8000
    }

    handle_path /health {
        reverse_proxy backend-api:8000
    }

    # Dashboard
    handle {
        reverse_proxy dashboard-ui:3000
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=63072000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Dev profile — HTTP only, no TLS
:80 {
    reverse_proxy backend-api:8000
}
